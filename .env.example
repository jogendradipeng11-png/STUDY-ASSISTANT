# GEMINI_API_KEY: Required for Gemini AI API calls (chat, live voice, transcription, TTS, vision).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY (Optional): Free-tier NVIDIA NIM API key from build.nvidia.com.
# Unlocks 12 automatic NVIDIA NIM chat/math fallback models (14+ total models with Gemini).
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# NVIDIA_MODEL / NVIDIA_MATH_MODEL / NVIDIA_MODELS (Optional): Override or prepend preferred NVIDIA NIM models.
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
NVIDIA_MATH_MODEL="qwen/qwen2.5-72b-instruct"
NVIDIA_MODELS=""

# Optional additional single-key AI providers (each unlocks more automatic failover models in Auto mode):
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
CEREBRAS_API_KEY=""
MISTRAL_API_KEY=""
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
