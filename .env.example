# GEMINI_API_KEY: Required for Gemini AI API calls (chat, live voice, transcription, TTS, vision).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY (Optional): Free-tier NVIDIA NIM API key from build.nvidia.com.
# When set in Settings > Secrets, Jogi Jarvis can route text chat, Math, and Study Notes
# through NVIDIA NIM directly or use it automatically as a fallback if Gemini hits a rate limit.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# NVIDIA_MODEL / NVIDIA_MATH_MODEL (Optional): Override default NVIDIA NIM models.
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
NVIDIA_MATH_MODEL="qwen/qwen2.5-72b-instruct"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
